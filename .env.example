# =============================================
# LLM 設定 — 三選一，取消對應區塊的 # 即可
# =============================================

# --- 方案 A：Ollama 本地模型（推薦，完全免費、無需帳號）---
# 1. 安裝 Ollama：https://ollama.com/download
# 2. 下載模型：ollama pull llama3.2:3b
# 3. 以下兩行保持空白或刪除即可，程式會自動使用 localhost:11434
# LITELLM_API_KEY=
# LITELLM_BASE_URL=

# --- 方案 B：HuggingFace Inference API（免費帳號即可）---
# 1. 註冊 https://huggingface.co/ 取得 Access Token（hf_xxxx）
# 2. 執行時加上 --model "huggingface/HuggingFaceH4/zephyr-7b-beta"
# LITELLM_API_KEY=hf_your_token_here
# LITELLM_BASE_URL=

# --- 方案 C：課程提供的 LiteLLM Proxy（若帳號仍有效）---
# LITELLM_API_KEY=your_api_key_here
# LITELLM_BASE_URL=https://your-litellm-endpoint/

# =============================================
# Embedding Model（三個方案都用這個，不需修改）
# =============================================
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# =============================================
# Vector DB
# =============================================
CHROMA_PERSIST_DIR=./chroma_db
